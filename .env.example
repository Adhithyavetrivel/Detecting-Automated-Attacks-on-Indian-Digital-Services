# Copy this file to `.env` and fill in real values for your machine.
# NEVER commit the actual `.env` file — it is already in .gitignore.

# --- General ---
APP_ENV=development
DEBUG=true

# --- Database ---
# SQLite default (zero setup). Example Postgres URL is shown for later:
# DATABASE_URL=postgresql+psycopg://netsentinel:password@localhost:5432/netsentinel
DATABASE_URL=sqlite:///./netsentinel.db

# --- Security ---
# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_this_with_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- Networking / Monitoring ---
# Set this to YOUR lab's subnet, e.g. 192.168.56.0/24 for a VirtualBox
# host-only network. Never point this at a network you don't own/control.
MONITOR_SUBNET=192.168.1.0/24
MONITOR_INTERFACE=eth0
PING_TIMEOUT_SECONDS=1.0
PING_INTERVAL_SECONDS=30

# --- SNMP ---
SNMP_COMMUNITY=public
SNMP_PORT=161
SNMP_TIMEOUT_SECONDS=2.0

# --- Detection thresholds ---
PORT_SCAN_PORT_THRESHOLD=15
PORT_SCAN_WINDOW_SECONDS=10
EXCESSIVE_CONNECTIONS_THRESHOLD=100
